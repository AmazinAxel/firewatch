# Copy to `.env` (gitignored) and fill in. Values are injected as compile-time
# defines by scripts/load_env.py — rebuild + reflash after changing them.

WIFI_SSID=your-network-name
WIFI_PASSWORD=your-network-password

# AirNow API key for the "gov" AQI row (same token the homelab webserver uses).
# Leave empty to render a dash in that row.
AIRNOW_TOKEN=

# Optional overrides (defaults shown; defaults live in include/config.h)
#HOMELAB_HOST=alechomelab.local
#ZIP=98226
#LAT=48.7877
#LON=-122.4432
